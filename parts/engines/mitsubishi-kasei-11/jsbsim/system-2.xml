<?xml version="1.0"?>
<!-- Generated by vehicles/tools/part_jsbsim.py from engine.json (mitsubishi-kasei-11) for engine position 2.
     Supercharger speed: second speed above 3230 m pressure altitude, where the model's
     full-throttle rated-rpm power in second speed first exceeds first speed's (engine.json change_altitude).
     Mixture: the sources do not describe the mixture control; the run position holds an auto-rich
     equivalence ratio (JSBSim meters phi = 1.3 * mixture * p0 / p_amb), the bottom of travel is cut-off.
     Charge heating: JSBSim prices the charge at ambient temperature. The throttle sits ahead of the
     gear-driven impeller, so the impeller's pressure ratio is set by the gear and crankshaft speed,
     (mul - 1) * rpm / rated rpm + 1 with mul 1.6164 / 2.0600, not by altitude; the charge leaves at
     T_amb * (1 + (PR^0.2857 - 1) / eta), eta FITTED, no intercooler, and T_amb / T_charge scales the
     volumetric efficiency. available-power-hp is what the propeller governor feeds forward: the larger of
     shaft power and what the manifold pressure can deliver, so a windmilling start does not settle on the
     fine stop. -->
<system name="mitsubishi-kasei-11-engine2">
    <channel name="mitsubishi-kasei-11 engine 2">
        <switch name="fcs/mixture-phi-2">
            <default value="1.25"/>
            <test logic="AND" value="0.0"> fcs/mixture-cmd-norm[2] LT 0.08 </test>
        </switch>
        <fcs_function name="fcs/mixture-amc-2">
            <function>
            <product>
                <property>fcs/mixture-phi-2</property>
                <property>atmosphere/P-psf</property>
                <value> 3.6349e-4 </value>
            </product>
            </function>
            <output>fcs/mixture-pos-norm[2]</output>
        </fcs_function>
        <switch name="propulsion/engine[2]/supercharger-speed">
            <default value="0.0"/>
            <test logic="AND" value="1.0"> atmosphere/pressure-altitude GT 10597 </test>
            <output>propulsion/engine[2]/boost-speed</output>
        </switch>
        <fcs_function name="propulsion/engine[2]/supercharger-pressure-ratio">
            <function>
            <sum>
                <value> 1.0 </value>
                <product>
                    <quotient>
                        <property>propulsion/engine[2]/engine-rpm</property>
                        <value> 2350.0 </value>
                    </quotient>
                    <ifthen>
                        <ge>
                            <property>propulsion/engine[2]/boost-speed</property>
                            <value> 1.0 </value>
                        </ge>
                        <value> 1.06004 </value>
                        <value> 0.61638 </value>
                    </ifthen>
                </product>
            </sum>
            </function>
        </fcs_function>
        <fcs_function name="propulsion/engine[2]/carb-air-temp-degR">
            <function>
            <product>
                <property>atmosphere/T-R</property>
                <sum>
                    <value> 1.0 </value>
                    <product>
                        <value> 1.78571 </value>
                        <difference>
                            <pow>
                                <property>propulsion/engine[2]/supercharger-pressure-ratio</property>
                                <value> 0.2857 </value>
                            </pow>
                            <value> 1.0 </value>
                        </difference>
                    </product>
                </sum>
            </product>
            </function>
        </fcs_function>
        <fcs_function name="propulsion/engine[2]/carb-air-temp-degC">
            <function>
            <difference>
                <product>
                    <property>propulsion/engine[2]/carb-air-temp-degR</property>
                    <value> 0.5555556 </value>
                </product>
                <value> 273.15 </value>
            </difference>
            </function>
        </fcs_function>
        <fcs_function name="propulsion/engine[2]/charge-density-factor">
            <function>
            <quotient>
                <property>atmosphere/T-R</property>
                <property>propulsion/engine[2]/carb-air-temp-degR</property>
            </quotient>
            </function>
        </fcs_function>
        <fcs_function name="propulsion/engine[2]/charge-volumetric-efficiency">
            <function>
            <product>
                <property>propulsion/engine[2]/charge-density-factor</property>
                <value> 0.85 </value>
            </product>
            </function>
            <output>propulsion/engine[2]/volumetric-efficiency</output>
        </fcs_function>
        <fcs_function name="propulsion/engine[2]/available-power-hp">
            <function>
            <max>
                <property>propulsion/engine[2]/power-hp</property>
                <product>
                    <difference>
                        <property>propulsion/engine[2]/map-inhg</property>
                        <value> 12.0 </value>
                    </difference>
                    <property>propulsion/engine[2]/charge-density-factor</property>
                    <value> 74.0 </value>
                </product>
            </max>
            </function>
        </fcs_function>
    </channel>
</system>
