  <flight_control name="fcs">
    <!-- Wheel speed fairings: the POH speeds assume them (about 2 kt); N642SP flies
         without them, so a handbook test card sets this to 1. -->
    <property value="0"> systems/wheel-fairings-installed </property>
    <!-- Control travel: elevator 28 up / 23 down, ailerons 20 up / 15 down (their
         mean, as one surface), rudder 16 each way. -->
    <channel name="Pitch">
      <summer name="fcs/pitch-sum">
        <input>fcs/elevator-cmd-norm</input>
        <input>fcs/pitch-trim-cmd-norm</input>
        <clipto> <min> -1 </min> <max> 1 </max> </clipto>
      </summer>
      <aerosurface_scale name="fcs/elevator-control">
        <input>fcs/pitch-sum</input>
        <range> <min> -0.4887 </min> <max> 0.4014 </max> </range>
        <output>fcs/elevator-pos-rad</output>
      </aerosurface_scale>
      <fcs_function name="fcs/mag-elevator-pos-rad">
        <function> <abs> <property>fcs/elevator-pos-rad</property> </abs> </function>
      </fcs_function>
    </channel>
    <channel name="Roll">
      <aerosurface_scale name="fcs/aileron-control">
        <input>fcs/aileron-cmd-norm</input>
        <range> <min> -0.3054 </min> <max> 0.3054 </max> </range>
        <output>fcs/left-aileron-pos-rad</output>
      </aerosurface_scale>
    </channel>
    <channel name="Yaw">
      <aerosurface_scale name="fcs/rudder-control">
        <input>fcs/rudder-cmd-norm</input>
        <range> <min> -0.2793 </min> <max> 0.2793 </max> </range>
        <output>fcs/rudder-pos-rad</output>
      </aerosurface_scale>
      <!-- JSBSim's positive rudder yaws the nose left and its positive steering
           turns right, so the pedal linkage reverses the sign. -->
      <pure_gain name="fcs/nose-wheel-steering">
        <input>fcs/rudder-cmd-norm</input>
        <gain> -1.0 </gain>
        <output>fcs/steer-cmd-norm</output>
      </pure_gain>
    </channel>
    <channel name="Flaps">
      <kinematic name="fcs/flap-control">
        <input>fcs/flap-cmd-norm</input>
        <traverse>
          <setting> <position> 0 </position> <time> 0 </time> </setting>
          <setting> <position> 1 </position> <time> 6 </time> </setting>
        </traverse>
        <output>fcs/flap-pos-norm</output>
      </kinematic>
    </channel>
    <channel name="Mixture">
      <!-- The RSA fuel servo meters fuel by the venturi's impact pressure, so its
           F/A at a fixed lever richens as 1/sqrt(sigma); JSBSim's lever law richens
           as p0/p, which this cancels. The full-rich stop meters F/A 0.097 at sea
           level (1.10 x the 1.3 lever law), rich of best power for cooling. -->
      <fcs_function name="fcs/mixture-servo">
        <function>
          <quotient>
            <product>
              <value> 1.10 </value>
              <property>fcs/mixture-cmd-norm</property>
              <quotient> <property>atmosphere/P-psf</property> <value> 2116.22 </value> </quotient>
            </product>
            <pow>
              <quotient> <property>atmosphere/rho-slugs_ft3</property> <value> 0.0023769 </value> </quotient>
              <value> 0.5 </value>
            </pow>
          </quotient>
        </function>
        <output>fcs/mixture-pos-norm[0]</output>
      </fcs_function>
    </channel>
  </flight_control>
