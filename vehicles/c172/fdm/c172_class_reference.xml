    <function name="aero/function/qbar-tail-psf">
      <description>Dynamic pressure at the tail: the full slipstream (free stream plus
        twice the disk's induced velocity) washes the elevator and rudder</description>
      <product>
        <value> 0.5 </value>
        <property>atmosphere/rho-slugs_ft3</property>
        <pow>
          <sum>
            <property>velocities/u-aero-fps</property>
            <property>propulsion/engine[0]/prop-induced-velocity_fps</property>
            <property>propulsion/engine[0]/prop-induced-velocity_fps</property>
          </sum>
          <value> 2 </value>
        </pow>
      </product>
    </function>
    <function name="aero/function/qbar-slip-psf">
      <description>Mean dynamic pressure over the parts in the slipstream: free stream
        plus 1.5 times the disk's induced velocity, between the disk (1) and the
        far wake (2)</description>
      <product>
        <value> 0.5 </value>
        <property>atmosphere/rho-slugs_ft3</property>
        <pow>
          <sum>
            <property>velocities/u-aero-fps</property>
            <product>
              <value> 1.5 </value>
              <property>propulsion/engine[0]/prop-induced-velocity_fps</property>
            </product>
          </sum>
          <value> 2 </value>
        </pow>
      </product>
    </function>
