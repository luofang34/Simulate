      <function name="aero/force/drag_slipstream">
        <description>Added drag of the parts washed by the slipstream (NACA TR 640
          p. 23, TR 684 p. 10): their drag area times the slipstream's dynamic
          pressure in excess of the free stream. Drag area 2.9 ft2 from a component
          build-up: fuselage and cowl 1.4, nose gear and the mains' washed share 0.6,
          wing roots 0.3, strut roots 0.05, tail 0.3, cooling 0.3.</description>
        <product>
          <value> 2.9 </value>
          <max>
            <value> 0 </value>
            <difference>
              <property>aero/function/qbar-slip-psf</property>
              <property>aero/qbar-psf</property>
            </difference>
          </max>
        </product>
      </function>
    </axis>
    <axis name="SIDE">
      <function name="aero/force/side">
        <description>Sideslip, roll rate and yaw rate side force</description>
        <product>
          <property>aero/qbar-psf</property>
          <property>metrics/Sw-sqft</property>
          <sum>
            <product> <value> -0.393 </value> <property>aero/beta-rad</property> </product>
            <product> <value> -0.075 </value> <property>aero/bi2vel</property> <property>velocities/p-aero-rad_sec</property> </product>
            <product> <value> 0.214 </value> <property>aero/bi2vel</property> <property>velocities/r-aero-rad_sec</property> </product>
          </sum>
        </product>
      </function>
      <function name="aero/force/side_rudder">
        <description>Rudder side force in the slipstream</description>
        <product>
          <property>aero/function/qbar-tail-psf</property>
          <property>metrics/Sw-sqft</property>
          <property>fcs/rudder-pos-rad</property>
          <value> 0.187 </value>
        </product>
      </function>
    </axis>
    <axis name="ROLL">
      <function name="aero/moment/roll">
        <description>Dihedral, damping, roll due to yaw rate (rising with lift),
          ailerons and rudder</description>
        <product>
          <property>aero/qbar-psf</property>
          <property>metrics/Sw-sqft</property>
          <property>metrics/bw-ft</property>
          <sum>
            <product> <value> -0.0923 </value> <property>aero/beta-rad</property> </product>
            <product> <value> -0.484 </value> <property>aero/bi2vel</property> <property>velocities/p-aero-rad_sec</property> </product>
            <product>
              <property>aero/bi2vel</property>
              <property>velocities/r-aero-rad_sec</property>
              <table>
                <independentVar lookup="row">aero/alpha-rad</independentVar>
                <tableData>
                  0.000 0.0798
                  0.094 0.1869
                  0.200 0.3000
                </tableData>
              </table>
            </product>
            <product> <value> 0.229 </value> <property>fcs/left-aileron-pos-rad</property> </product>
            <product> <value> 0.0147 </value> <property>fcs/rudder-pos-rad</property> </product>
          </sum>
        </product>
      </function>
    </axis>
    <axis name="PITCH">
      <function name="aero/moment/pitch">
        <description>Static stability, pitch and alpha-rate damping, flap moment</description>
        <product>
          <property>aero/qbar-psf</property>
          <property>metrics/Sw-sqft</property>
          <property>metrics/cbarw-ft</property>
          <sum>
            <value> 0.034988 </value>
            <product> <value> -0.900000 </value> <property>aero/alpha-rad</property> </product>
            <product> <value> -12.4 </value> <property>aero/ci2vel</property> <property>velocities/q-aero-rad_sec</property> </product>
            <product> <value> -7.27 </value> <property>aero/ci2vel</property> <property>aero/alphadot-rad_sec</property> </product>
            <table>
              <independentVar lookup="row">fcs/flap-pos-norm</independentVar>
              <tableData>
                0.0000  0.0000
                0.3333 -0.0654
                0.6667 -0.0981
                1.0000 -0.1140
              </tableData>
            </table>
          </sum>
        </product>
      </function>
      <function name="aero/moment/pitch_elevator">
        <description>Elevator in the slipstream</description>
        <product>
          <property>aero/function/qbar-tail-psf</property>
          <property>metrics/Sw-sqft</property>
          <property>metrics/cbarw-ft</property>
          <property>fcs/elevator-pos-rad</property>
          <value> -1.122 </value>
        </product>
      </function>
    </axis>
    <axis name="YAW">
      <function name="aero/moment/yaw">
        <description>Weathercock stability, damping, adverse aileron yaw</description>
        <product>
          <property>aero/qbar-psf</property>
          <property>metrics/Sw-sqft</property>
          <property>metrics/bw-ft</property>
          <sum>
            <product> <value> 0.0587 </value> <property>aero/beta-rad</property> </product>
            <product> <value> -0.0278 </value> <property>aero/bi2vel</property> <property>velocities/p-aero-rad_sec</property> </product>
            <product> <value> -0.0937 </value> <property>aero/bi2vel</property> <property>velocities/r-aero-rad_sec</property> </product>
            <product> <value> -0.0053 </value> <property>fcs/left-aileron-pos-rad</property> </product>
          </sum>
        </product>
      </function>
      <function name="aero/moment/yaw_rudder">
        <description>Rudder in the slipstream</description>
        <product>
          <property>aero/function/qbar-tail-psf</property>
          <property>metrics/Sw-sqft</property>
          <property>metrics/bw-ft</property>
          <property>fcs/rudder-pos-rad</property>
          <value> -0.043 </value>
        </product>
      </function>
    </axis>
  </aerodynamics>
