#usda 1.0
(
    defaultPrim = "C172"
    doc = """N642SP (1998 Cessna 172S Skyhawk SP, S/N 172S8050, Blue Sky Aviation Association)
over the generic BSD-3-Clause c172.usdc airframe. Every opinion here is a difference
of this tail from the generic asset; sources are cited at each prim.
Photos: blueskyaa.com antenna post 2017-11-13 (IMG_6025/6030/6031/6058) and 2024-03
(IMG_7150-7157); airport-data.com 024252 (2006), 820598 (2012); FlightAware 2020-2021.
Dimensions: Cessna 172S Information Manual rev 5 (2004), Fig. 1-1 and Fig. 6-1."""
    metersPerUnit = 1
    subLayers = [@c172.usdc@]
    upAxis = "Z"
)

over "C172"
{
    string sim:tail = "N642SP"

    over "Materials"
    {
        # McCauley 1C235 blades: satin black faces with white tips (airport-data 024252).
        def Material "MatPropBladeSatinBlack"
        {
            token outputs:surface.connect = </C172/Materials/MatPropBladeSatinBlack/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.035, 0.035, 0.04)
                float inputs:metallic = 0.05
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "MatPropTipWhite"
        {
            token outputs:surface.connect = </C172/Materials/MatPropTipWhite/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.88, 0.88, 0.86)
                float inputs:metallic = 0
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        # Heat-coloured stainless exhaust tailpipe (IMG_7156).
        def Material "MatExhaustSteel"
        {
            token outputs:surface.connect = </C172/Materials/MatExhaustSteel/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.36, 0.33, 0.31)
                float inputs:metallic = 0.6
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        # Light grey cabin headliner (172S interior, generic).
        def Material "MatHeadliner"
        {
            token outputs:surface.connect = </C172/Materials/MatHeadliner/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.6, 0.58, 0.55)
                float inputs:metallic = 0
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        # Cast wheel halves, brake disc and caliper.
        def Material "MatWheelAlloy"
        {
            token outputs:surface.connect = </C172/Materials/MatWheelAlloy/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.56, 0.57)
                float inputs:metallic = 0.7
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "MatBrakeSteel"
        {
            token outputs:surface.connect = </C172/Materials/MatBrakeSteel/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.3, 0.29, 0.28)
                float inputs:metallic = 0.8
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }
    }

    over "Airframe"
    {
        # The wing, roof, stabilizer and struts are white paint in every photo.
        over "HighWingTrim"
        {
            rel material:binding = </C172/Materials/MatWhitePaint>
        }

        over "CabinTrim"
        {
            rel material:binding = </C172/Materials/MatWhitePaint>
        }

        over "WingStruts"
        {
            rel material:binding = </C172/Materials/MatExhaustSteel>
        }

        # No wheel fairings since at least 2017 (IMG_6058, FlightAware 2020-2021, IMG_7156).
        over "WheelFairingLeft" (
            active = false
        )
        {
        }

        over "WheelFairingRight" (
            active = false
        )
        {
        }

        over "NoseWheelFairing" (
            active = false
        )
        {
        }

        # Legs follow their axles (see /C172/LandingGear).
        over "MainGearLegLeft"
        {
            double3 xformOp:translate = (0, 0.014, 0.0423)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        over "MainGearLegRight"
        {
            double3 xformOp:translate = (0, 0.019, 0.0423)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        over "NoseGearStrut"
        {
            double3 xformOp:translate = (0, -0.115, 0.015)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        # Main brake calipers, fixed to the axle aft of the disc.
        def Cube "BrakeCaliperLeft" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            double size = 1
            double3 xformOp:translate = (-1.2, -0.495, -1.035)
            float3 xformOp:scale = (0.035, 0.05, 0.06)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            rel material:binding = </C172/Materials/MatBrakeSteel>
            custom token sim:partRole = "gear_struts"
        }

        def Cube "BrakeCaliperRight" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            double size = 1
            double3 xformOp:translate = (1.2, -0.495, -1.035)
            float3 xformOp:scale = (0.035, 0.05, 0.06)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            rel material:binding = </C172/Materials/MatBrakeSteel>
            custom token sim:partRole = "gear_struts"
        }

        # Headliner 3 cm under the roof skin, which slopes down 6.6 deg aft
        # (z = 0.76 + 0.115 y), closing the cabin overhead from the pilot's eye.
        def Cube "Headliner" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            double size = 1
            double3 xformOp:translate = (0, -0.3, 0.6955)
            float xformOp:rotateX = 6.56
            float3 xformOp:scale = (0.94, 1.3, 0.01)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX", "xformOp:scale"]
            rel material:binding = </C172/Materials/MatHeadliner>
            custom token sim:partRole = "cabin_interior"
        }

        # Bare nose gear (IMG_7156/7157): painted oleo cylinder, polished piston and a
        # fork straddling the 5.00-5 tyre down to the axle. Sizes are estimated from the
        # photos against the tyre width; the fork does not steer with the wheel.
        def Cylinder "NoseOleoCylinder" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.2
            double radius = 0.034
            double3 xformOp:translate = (0, 1.262, -0.76)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            rel material:binding = </C172/Materials/MatWhitePaint>
            custom token sim:partRole = "gear_struts"
        }

        def Cylinder "NoseOleoPiston" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.09
            double radius = 0.024
            double3 xformOp:translate = (0, 1.256, -0.9)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            rel material:binding = </C172/Materials/MatPolishedChrome>
            custom token sim:partRole = "gear_struts"
        }

        def Cube "NoseForkCrown" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            double size = 1
            double3 xformOp:translate = (0, 1.252, -0.955)
            float3 xformOp:scale = (0.2, 0.06, 0.03)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            rel material:binding = </C172/Materials/MatWheelAlloy>
            custom token sim:partRole = "gear_struts"
        }

        def Cube "NoseForkLeft" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            double size = 1
            double3 xformOp:translate = (-0.088, 1.248, -1.005)
            float3 xformOp:scale = (0.014, 0.05, 0.11)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            rel material:binding = </C172/Materials/MatWheelAlloy>
            custom token sim:partRole = "gear_struts"
        }

        def Cube "NoseForkRight" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            double size = 1
            double3 xformOp:translate = (0.088, 1.248, -1.005)
            float3 xformOp:scale = (0.014, 0.05, 0.11)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            rel material:binding = </C172/Materials/MatWheelAlloy>
            custom token sim:partRole = "gear_struts"
        }

        # LORD shimmy damper beside the nose strut (IMG_7156).
        def Cylinder "NoseShimmyDamper" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token axis = "Y"
            double height = 0.17
            double radius = 0.018
            double3 xformOp:translate = (0.05, 1.21, -0.82)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            rel material:binding = </C172/Materials/MatWhitePaint>
            custom token sim:partRole = "gear_struts"
        }
    }

    over "Powerplant"
    {
        over "PropellerHub"
        {
            # The spinner is white paint (airport-data 024252, FlightAware N51).
            over "Spinner"
            {
                rel material:binding = </C172/Materials/MatWhitePaint>
            }

            over "PropellerBlades"
            {
                rel material:binding = </C172/Materials/MatPropBladeSatinBlack>
            }

            over "PropellerSafetyTips"
            {
                rel material:binding = </C172/Materials/MatPropTipWhite>
            }
        }
    }

    # Axles on POH Fig. 1-1: nose 42.9 in and mains 108.1 in aft of the spinner tip
    # (wheel base 65.2 in; Note 2 gives 65 in). Tyres 6.00-6 main (17.5 x 6.3 in) and
    # 5.00-5 nose (14.2 x 5.05 in); axles raised so the tyre bottoms stay at the generic
    # asset's z (mains -1.23 m, nose -1.235 m).
    over "LandingGear"
    {
        over "NoseWheel"
        {
            double3 xformOp:translate = (0, 1.245, -1.0547)

            over "Tire"
            {
                float3 xformOp:scale = (1.336, 1.093, 1.093)
                uniform token[] xformOpOrder = ["xformOp:scale"]
            }

            over "Hubcap"
            {
                rel material:binding = </C172/Materials/MatWheelAlloy>
                float3 xformOp:scale = (1.336, 1, 1)
                uniform token[] xformOpOrder = ["xformOp:scale"]
            }
        }

        over "WheelLeft"
        {
            double3 xformOp:translate = (-1.29, -0.411, -1.0077)

            over "Tire"
            {
                float3 xformOp:scale = (1.481, 1.235, 1.235)
                uniform token[] xformOpOrder = ["xformOp:scale"]
            }

            over "Hubcap"
            {
                rel material:binding = </C172/Materials/MatWheelAlloy>
                float3 xformOp:scale = (1.481, 1, 1)
                uniform token[] xformOpOrder = ["xformOp:scale"]
            }

            def Cylinder "BrakeDisc" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                uniform token axis = "X"
                double height = 0.008
                double radius = 0.1
                double3 xformOp:translate = (0.088, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate"]
                rel material:binding = </C172/Materials/MatBrakeSteel>
                custom token sim:partRole = "wheel_left"
            }
        }

        over "WheelRight"
        {
            double3 xformOp:translate = (1.29, -0.411, -1.0077)

            over "Tire"
            {
                float3 xformOp:scale = (1.481, 1.235, 1.235)
                uniform token[] xformOpOrder = ["xformOp:scale"]
            }

            over "Hubcap"
            {
                rel material:binding = </C172/Materials/MatWheelAlloy>
                float3 xformOp:scale = (1.481, 1, 1)
                uniform token[] xformOpOrder = ["xformOp:scale"]
            }

            def Cylinder "BrakeDisc" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                uniform token axis = "X"
                double height = 0.008
                double radius = 0.1
                double3 xformOp:translate = (-0.088, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate"]
                rel material:binding = </C172/Materials/MatBrakeSteel>
                custom token sim:partRole = "wheel_right"
            }
        }
    }
}
