<?xml version="1.0"?>
<fdm_config name="g4m1" version="2.0" release="BETA">

    <fileheader>
        <author>Simulate Reference Flight Dynamics</author>
        <filecreationdate>2026-11-09</filecreationdate>
        <version>1.0</version>
        <description>
            Mitsubishi G4M1 Model 11 (Navy Type 1 attack bomber, Allied "Betty") airframe: wing, fuselage,
            tail, gear, fuel system and aerodynamics. The engines and propellers are parts the variant
            manifest pins (parts/engines, parts/propellers). Sourced geometry: span 24.88 m, length 19.97 m,
            wing area 78.125 m2, MAC118 section 12.5 % root to 10 % tip, taper 1:4, incidence and washout
            2 deg 52 min (JA Wikipedia 一式陸上攻撃機 citing 松葉 2009). The drag is fitted to the Navy test
            of aircraft No. 1 (Kasei 11, collector exhausts, no armour) at the 9,500 kg reconnaissance-normal
            weight (WarbirdPerformanceBlog tabulation of the 試験成績); see performance/kasei11/poh_benchmarks.json.
        </description>
    </fileheader>

    <!-- Wing: 840.9 ft2, 81.63 ft. MAC 11.52 ft from the sourced 1:4 taper (root 16.5 ft, tip 4.1 ft).
         Tail areas are NOT sourced: estimated with bomber tail-volume coefficients (horizontal 0.55,
         vertical 0.045) on a 33 ft tail arm. Stations (in, aft of the nose) are estimated from the
         19.97 m length; the moment reference is the quarter-chord of the MAC. -->
    <metrics>
        <wingarea unit="FT2"> 840.9 </wingarea>
        <wingspan unit="FT"> 81.63 </wingspan>
        <chord unit="FT"> 11.52 </chord>
        <wing_incidence unit="DEG"> 2.87 </wing_incidence>
        <htailarea unit="FT2"> 162.0 </htailarea>
        <htailarm unit="FT"> 33.0 </htailarm>
        <vtailarea unit="FT2"> 94.0 </vtailarea>
        <vtailarm unit="FT"> 33.0 </vtailarm>
        <location name="AERORP" unit="IN">
            <x> 283.0 </x>
            <y>   0.0 </y>
            <z>   0.0 </z>
        </location>
        <location name="EYEPOINT" unit="IN">
            <x> 150.0 </x>
            <y> -16.0 </y>
            <z>  40.0 </z>
        </location>
        <location name="VRP" unit="IN">
            <x> 283.0 </x>
            <y>   0.0 </y>
            <z>   0.0 </z>
        </location>
    </metrics>

    <mass_balance>
        <!-- Empty 7,000 kg (15,432 lb): the Model 11 figure on the same Navy sheet as the test weights
             (WarbirdPerformanceBlog); Francillon's 6,741 kg is the Kasei 15 aircraft. The default load
             is the 9,500 kg reconnaissance-normal state the Navy tested: 7 crew, oil, defensive
             ammunition and 3,630 lb (2,290 L) of the 4,900 L integral tankage. pointmass[0] is the
             payload slot the calibration harness adjusts to reach a benchmark's gross weight.
             Inertias are NOT sourced: Roskam twin-propeller radii of gyration (Rx 0.30, Ry 0.33,
             Rz 0.44) at 9,500 kg, less what the fuel and point masses add. CG at 25 % MAC, estimated. -->
        <ixx unit="SLUG*FT2"> 80000.0 </ixx>
        <iyy unit="SLUG*FT2"> 72000.0 </iyy>
        <izz unit="SLUG*FT2"> 150000.0 </izz>
        <emptywt unit="LBS"> 15432.36 </emptywt>
        <location name="CG" unit="IN">
            <x> 283.0 </x>
            <y>   0.0 </y>
            <z>   0.0 </z>
        </location>
        <pointmass name="Crew of 7 with parachutes">
            <weight unit="LBS"> 1150.0 </weight>
            <location name="POINTMASS" unit="IN">
                <x> 250.0 </x>
                <y>   0.0 </y>
                <z>  10.0 </z>
            </location>
        </pointmass>
        <pointmass name="Engine oil, 2 engines (estimated)">
            <weight unit="LBS"> 400.0 </weight>
            <location name="POINTMASS" unit="IN">
                <x> 180.0 </x>
                <y>   0.0 </y>
                <z>   0.0 </z>
            </location>
        </pointmass>
        <pointmass name="Defensive ammunition, 7.7 mm and 20 mm (estimated)">
            <weight unit="LBS"> 330.0 </weight>
            <location name="POINTMASS" unit="IN">
                <x> 420.0 </x>
                <y>   0.0 </y>
                <z>  10.0 </z>
            </location>
        </pointmass>
    </mass_balance>

    <!-- Conventional gear with mains retracting into the nacelles and a tail wheel. Positions and
         spring rates are estimated (no gear data in the sources); they give a ~6 deg three-point
         attitude and a propeller tip clearance of about 1 ft. -->
    <ground_reactions>
        <contact type="BOGEY" name="LEFT_MAIN">
            <location unit="IN">
                <x> 240.0 </x>
                <y> -138.0 </y>
                <z> -95.0 </z>
            </location>
            <static_friction> 0.80 </static_friction>
            <dynamic_friction> 0.50 </dynamic_friction>
            <rolling_friction> 0.020 </rolling_friction>
            <spring_coeff unit="LBS/FT"> 40000.0 </spring_coeff>
            <damping_coeff unit="LBS/FT/SEC"> 12000.0 </damping_coeff>
            <damping_coeff_rebound unit="LBS/FT/SEC"> 24000.0 </damping_coeff_rebound>
            <max_steer unit="DEG"> 0.0 </max_steer>
            <brake_group> LEFT </brake_group>
            <retractable> 1 </retractable>
        </contact>
        <contact type="BOGEY" name="RIGHT_MAIN">
            <location unit="IN">
                <x> 240.0 </x>
                <y> 138.0 </y>
                <z> -95.0 </z>
            </location>
            <static_friction> 0.80 </static_friction>
            <dynamic_friction> 0.50 </dynamic_friction>
            <rolling_friction> 0.020 </rolling_friction>
            <spring_coeff unit="LBS/FT"> 40000.0 </spring_coeff>
            <damping_coeff unit="LBS/FT/SEC"> 12000.0 </damping_coeff>
            <damping_coeff_rebound unit="LBS/FT/SEC"> 24000.0 </damping_coeff_rebound>
            <max_steer unit="DEG"> 0.0 </max_steer>
            <brake_group> RIGHT </brake_group>
            <retractable> 1 </retractable>
        </contact>
        <contact type="BOGEY" name="TAIL">
            <location unit="IN">
                <x> 700.0 </x>
                <y>   0.0 </y>
                <z> -40.0 </z>
            </location>
            <static_friction> 0.80 </static_friction>
            <dynamic_friction> 0.50 </dynamic_friction>
            <rolling_friction> 0.030 </rolling_friction>
            <spring_coeff unit="LBS/FT"> 12000.0 </spring_coeff>
            <damping_coeff unit="LBS/FT/SEC"> 4000.0 </damping_coeff>
            <damping_coeff_rebound unit="LBS/FT/SEC"> 8000.0 </damping_coeff_rebound>
            <max_steer unit="DEG"> 0.0 </max_steer>
            <brake_group> NONE </brake_group>
            <retractable> 0 </retractable>
        </contact>
        <contact type="STRUCTURE" name="BELLY">
            <location unit="IN">
                <x> 283.0 </x>
                <y>   0.0 </y>
                <z> -50.0 </z>
            </location>
            <static_friction> 0.80 </static_friction>
            <dynamic_friction> 0.50 </dynamic_friction>
            <spring_coeff unit="LBS/FT"> 80000.0 </spring_coeff>
            <damping_coeff unit="LBS/FT/SEC"> 16000.0 </damping_coeff>
        </contact>
    </ground_reactions>

    <propulsion>
        <!-- About 4,900 L in unprotected integral tanks between the wing spars (JA Wikipedia
             一式陸上攻撃機). The per-tank split (700/640/660/450 L a side) is a forum figure, used
             only because no primary split was found; 92-octane at 0.72 kg/L. Engine 0 feeds from
             the left tanks, engine 1 from the right. -->

        <!-- 0: left No.1 (inboard, centre section), 700 L -->
        <tank type="FUEL">
            <location unit="IN">
                <x> 270.0 </x>
                <y> -60.0 </y>
                <z> 0.0 </z>
            </location>
            <capacity unit="LBS"> 1111.1 </capacity>
            <contents unit="LBS"> 520.0 </contents>
        </tank>
        <!-- 1: right No.1 (inboard, centre section), 700 L -->
        <tank type="FUEL">
            <location unit="IN">
                <x> 270.0 </x>
                <y> 60.0 </y>
                <z> 0.0 </z>
            </location>
            <capacity unit="LBS"> 1111.1 </capacity>
            <contents unit="LBS"> 520.0 </contents>
        </tank>
        <!-- 2: left No.2 (between fuselage and nacelle), 640 L -->
        <tank type="FUEL">
            <location unit="IN">
                <x> 290.0 </x>
                <y> -100.0 </y>
                <z> 0.0 </z>
            </location>
            <capacity unit="LBS"> 1015.9 </capacity>
            <contents unit="LBS"> 475.0 </contents>
        </tank>
        <!-- 3: right No.2 (between fuselage and nacelle), 640 L -->
        <tank type="FUEL">
            <location unit="IN">
                <x> 290.0 </x>
                <y> 100.0 </y>
                <z> 0.0 </z>
            </location>
            <capacity unit="LBS"> 1015.9 </capacity>
            <contents unit="LBS"> 475.0 </contents>
        </tank>
        <!-- 4: left No.3 (outboard of nacelle), 660 L -->
        <tank type="FUEL">
            <location unit="IN">
                <x> 280.0 </x>
                <y> -190.0 </y>
                <z> 0.0 </z>
            </location>
            <capacity unit="LBS"> 1047.6 </capacity>
            <contents unit="LBS"> 490.0 </contents>
        </tank>
        <!-- 5: right No.3 (outboard of nacelle), 660 L -->
        <tank type="FUEL">
            <location unit="IN">
                <x> 280.0 </x>
                <y> 190.0 </y>
                <z> 0.0 </z>
            </location>
            <capacity unit="LBS"> 1047.6 </capacity>
            <contents unit="LBS"> 490.0 </contents>
        </tank>
        <!-- 6: left No.4 (outer wing), 450 L -->
        <tank type="FUEL">
            <location unit="IN">
                <x> 290.0 </x>
                <y> -260.0 </y>
                <z> 0.0 </z>
            </location>
            <capacity unit="LBS"> 714.3 </capacity>
            <contents unit="LBS"> 330.0 </contents>
        </tank>
        <!-- 7: right No.4 (outer wing), 450 L -->
        <tank type="FUEL">
            <location unit="IN">
                <x> 290.0 </x>
                <y> 260.0 </y>
                <z> 0.0 </z>
            </location>
            <capacity unit="LBS"> 714.3 </capacity>
            <contents unit="LBS"> 330.0 </contents>
        </tank>

        <!-- Engine 0 (left): the variant's engine part in role engine0 and propeller part in role
             propeller0 (see the variant manifest), fed from the left wing's tanks. Thrust line ESTIMATED from
             the 19.97 m length; both propellers turn the same way (no handed engines in the sources). -->
        <engine file="engine0">
            <feed> 0 </feed>
            <feed> 2 </feed>
            <feed> 4 </feed>
            <feed> 6 </feed>
            <thruster file="propeller0">
                <location unit="IN">
                    <x> 118.0 </x>
                    <y> -138.0 </y>
                    <z> -6.0 </z>
                </location>
                <orient unit="DEG">
                    <roll>  0.0 </roll>
                    <pitch> 0.0 </pitch>
                    <yaw>   0.0 </yaw>
                </orient>
                <sense> 1 </sense>
            </thruster>
        </engine>
        <!-- Engine 1 (right): the variant's engine part in role engine1 and propeller part in role
             propeller1 (see the variant manifest), fed from the right wing's tanks. Thrust line ESTIMATED from
             the 19.97 m length; both propellers turn the same way (no handed engines in the sources). -->
        <engine file="engine1">
            <feed> 1 </feed>
            <feed> 3 </feed>
            <feed> 5 </feed>
            <feed> 7 </feed>
            <thruster file="propeller1">
                <location unit="IN">
                    <x> 118.0 </x>
                    <y>  138.0 </y>
                    <z> -6.0 </z>
                </location>
                <orient unit="DEG">
                    <roll>  0.0 </roll>
                    <pitch> 0.0 </pitch>
                    <yaw>   0.0 </yaw>
                </orient>
                <sense> 1 </sense>
            </thruster>
        </engine>
    </propulsion>

    <!-- The engine and propeller parts' per-position systems: mixture, charge heating and the governor
         feed-forward from the engine part, the constant-speed governor from the propeller part. Engines
         first, since each governor reads what its engine's system publishes in the same frame. -->
    <system file="engine0"/>
    <system file="engine1"/>
    <system file="propeller0"/>
    <system file="propeller1"/>

    <flight_control name="FCS: g4m1">
        <channel name="Pitch">
            <summer name="fcs/pitch-sum">
                <input>fcs/elevator-cmd-norm</input>
                <input>fcs/pitch-trim-cmd-norm</input>
                <clipto>
                    <min> -1.0 </min>
                    <max>  1.0 </max>
                </clipto>
            </summer>
            <aerosurface_scale name="fcs/elevator-control">
                <input>fcs/pitch-sum</input>
                <range>
                    <min> -0.40 </min>
                    <max>  0.30 </max>
                </range>
                <output>fcs/elevator-pos-rad</output>
            </aerosurface_scale>
        </channel>
        <channel name="Roll">
            <aerosurface_scale name="fcs/left-aileron-control">
                <input>fcs/aileron-cmd-norm</input>
                <range>
                    <min> -0.35 </min>
                    <max>  0.35 </max>
                </range>
                <output>fcs/left-aileron-pos-rad</output>
            </aerosurface_scale>
            <aerosurface_scale name="fcs/right-aileron-control">
                <input>-fcs/aileron-cmd-norm</input>
                <range>
                    <min> -0.35 </min>
                    <max>  0.35 </max>
                </range>
                <output>fcs/right-aileron-pos-rad</output>
            </aerosurface_scale>
        </channel>
        <channel name="Yaw">
            <aerosurface_scale name="fcs/rudder-control">
                <input>fcs/rudder-cmd-norm</input>
                <range>
                    <min> -0.45 </min>
                    <max>  0.45 </max>
                </range>
                <output>fcs/rudder-pos-rad</output>
            </aerosurface_scale>
        </channel>
        <channel name="Flaps">
            <!-- Electrically driven slotted flaps (JA Wikipedia 一式陸上攻撃機); the 45 deg full travel
                 is ESTIMATED. -->
            <aerosurface_scale name="fcs/flap-deg">
                <input>fcs/flap-cmd-norm</input>
                <range>
                    <min>  0.0 </min>
                    <max> 45.0 </max>
                </range>
                <output>fcs/flap-pos-deg</output>
            </aerosurface_scale>
            <aerosurface_scale name="fcs/flap-norm">
                <input>fcs/flap-pos-deg</input>
                <domain>
                    <min>  0.0 </min>
                    <max> 45.0 </max>
                </domain>
                <range>
                    <min> 0.0 </min>
                    <max> 1.0 </max>
                </range>
                <output>fcs/flap-pos-norm</output>
            </aerosurface_scale>
        </channel>
    </flight_control>

    <aerodynamics>
        <axis name="LIFT">
            <function name="aero/force/Lift_alpha">
                <!-- MAC118 has no public polar. Lift slope 4.77 /rad: 0.95 x 2 pi section slope with
                     the AR 7.92 finite-wing correction a0 AR / (AR + 2); zero lift at -3.7 deg body
                     alpha (2 deg 52 min incidence less half the washout, plus an assumed -2 deg
                     camber zero-lift angle). Clean CLmax 1.40 is ESTIMATED for a 12.5 % section
                     without flaps. -->
                <description>Lift due to alpha</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <table>
                        <independentVar lookup="row">aero/alpha-rad</independentVar>
                        <tableData>
                            -0.3000  -0.800
                            -0.2000  -0.646
                            -0.1000  -0.169
                             0.0000   0.308
                             0.0500   0.547
                             0.1000   0.785
                             0.1500   1.024
                             0.1800   1.150
                             0.2100   1.280
                             0.2400   1.360
                             0.2600   1.400
                             0.2900   1.300
                             0.3300   1.100
                             0.4500   0.850
                        </tableData>
                    </table>
                </product>
            </function>
            <function name="aero/force/Lift_flap">
                <!-- Slotted-flap increment ESTIMATED so the flaps-down CLmax is ~1.8, consistent with
                     Francillon's unconditioned 120 km/h stall at the 9,500 kg normal weight
                     (CL 1.76); that figure has no stated weight or configuration and is not graded. -->
                <description>Lift due to flaps</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <table>
                        <independentVar lookup="row">fcs/flap-pos-deg</independentVar>
                        <tableData>
                             0.0   0.000
                            15.0   0.150
                            30.0   0.300
                            45.0   0.400
                        </tableData>
                    </table>
                </product>
            </function>
            <function name="aero/force/Lift_elevator">
                <description>Lift due to elevator deflection</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>fcs/elevator-pos-rad</property>
                    <value> 0.350 </value>
                </product>
            </function>
        </axis>

        <axis name="DRAG">
            <function name="aero/force/Drag_zero_lift">
                <!-- Zero-lift drag FITTED to the Navy test of No. 1 at 9,500 kg and rated power
                     (236.0 kt at 2,400 m, 240.0 kt at 4,200 m), the same points the test card grades. -->
                <description>Zero-lift drag</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <value> 0.0247 </value>
                </product>
            </function>
            <function name="aero/force/Drag_induced">
                <!-- k = 1 / (pi AR e), e = 0.70, FITTED to the test's 8,000 m-to-ceiling climb band and
                     its 9,520 m service ceiling, which the card grades. The two speed points barely
                     constrain it (CL 0.2-0.3). -->
                <description>Induced drag</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>aero/cl-squared</property>
                    <value> 0.057 </value>
                </product>
            </function>
            <function name="aero/force/Drag_stall">
                <description>Separated-flow drag beyond the stall</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <table>
                        <independentVar lookup="row">aero/alpha-rad</independentVar>
                        <tableData>
                            -0.3500   0.150
                            -0.2200   0.000
                             0.2400   0.000
                             0.3000   0.060
                             0.4500   0.300
                        </tableData>
                    </table>
                </product>
            </function>
            <function name="aero/force/Drag_flap">
                <description>Drag due to slotted flaps (estimated)</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <table>
                        <independentVar lookup="row">fcs/flap-pos-deg</independentVar>
                        <tableData>
                             0.0   0.0000
                            15.0   0.0080
                            30.0   0.0300
                            45.0   0.0600
                        </tableData>
                    </table>
                </product>
            </function>
            <function name="aero/force/Drag_gear">
                <description>Drag due to the extended main and tail gear (estimated)</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>gear/gear-pos-norm</property>
                    <value> 0.0200 </value>
                </product>
            </function>
            <function name="aero/force/Drag_mach">
                <description>Compressibility drag rise (estimated, thick blunt airframe)</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <table>
                        <independentVar lookup="row">velocities/mach</independentVar>
                        <tableData>
                            0.00   0.0000
                            0.55   0.0000
                            0.60   0.0020
                            0.65   0.0080
                            0.70   0.0250
                            0.75   0.0600
                        </tableData>
                    </table>
                </product>
            </function>
            <function name="aero/force/Drag_beta">
                <description>Drag due to sideslip</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>aero/mag-beta-rad</property>
                    <value> 0.150 </value>
                </product>
            </function>
        </axis>

        <!-- Lateral-directional derivatives are ESTIMATED from conventional twin-engine bomber
             values; none are sourced for the G4M1. -->
        <axis name="SIDE">
            <function name="aero/force/Side_beta">
                <description>Side force due to beta</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>aero/beta-rad</property>
                    <value> -0.550 </value>
                </product>
            </function>
            <function name="aero/force/Side_rudder">
                <description>Side force due to rudder</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>fcs/rudder-pos-rad</property>
                    <value> 0.160 </value>
                </product>
            </function>
        </axis>

        <axis name="ROLL">
            <function name="aero/moment/Roll_beta">
                <description>Roll moment due to beta</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>metrics/bw-ft</property>
                    <property>aero/beta-rad</property>
                    <value> -0.080 </value>
                </product>
            </function>
            <function name="aero/moment/Roll_damp">
                <description>Roll damping</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>metrics/bw-ft</property>
                    <property>aero/bi2vel</property>
                    <property>velocities/p-aero-rad_sec</property>
                    <value> -0.450 </value>
                </product>
            </function>
            <function name="aero/moment/Roll_yaw">
                <description>Roll moment due to yaw rate</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>metrics/bw-ft</property>
                    <property>aero/bi2vel</property>
                    <property>velocities/r-aero-rad_sec</property>
                    <value> 0.120 </value>
                </product>
            </function>
            <function name="aero/moment/Roll_aileron">
                <description>Roll moment due to ailerons</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>metrics/bw-ft</property>
                    <property>fcs/left-aileron-pos-rad</property>
                    <value> 0.150 </value>
                </product>
            </function>
        </axis>

        <axis name="PITCH">
            <function name="aero/moment/Pitch_zero">
                <description>Zero-alpha pitching moment (estimated)</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>metrics/cbarw-ft</property>
                    <value> 0.020 </value>
                </product>
            </function>
            <function name="aero/moment/Pitch_alpha">
                <description>Pitch moment due to alpha (about 12 % MAC static margin, estimated)</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>metrics/cbarw-ft</property>
                    <property>aero/alpha-rad</property>
                    <value> -0.600 </value>
                </product>
            </function>
