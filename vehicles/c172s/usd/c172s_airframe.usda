#usda 1.0
(
    defaultPrim = "C172"
    doc = """Cessna 172S Skyhawk SP variant airframe layer over the generic BSD-3-Clause
c172.usdc mesh: 65.0-in POH wheelbase with bare 6.00-6 main and 5.00-5 nose gear,
brake discs and calipers, cabin headliner, VHF/GPS/ELT/VOR/transponder/ADF/ADS-B
antennas, nav/strobe/landing/taxi/tail lenses, stall-warning inlet, pitot mast and
tube, right-elevator trim tab, static wicks, and white base coat."""
    metersPerUnit = 1
    upAxis = "Z"
)

over "C172"
{
    over "Materials"
    {
        def Material "MatPropBladeSatinBlack"
        {
            token outputs:surface.connect = </C172/Materials/MatPropBladeSatinBlack/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.035, 0.035, 0.04)
                float inputs:metallic = 0.05
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "MatPropTipWhite"
        {
            token outputs:surface.connect = </C172/Materials/MatPropTipWhite/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.88, 0.88, 0.86)
                float inputs:metallic = 0
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "MatExhaustSteel"
        {
            token outputs:surface.connect = </C172/Materials/MatExhaustSteel/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
